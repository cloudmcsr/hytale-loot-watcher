builderTools.settings.HideCompass.description = Hide the compass while in Creative mode
builderTools.settings.HideNotifications.description = Hide notifications while in Creative mode
builderTools.settings.HideChat.description = Hide the chat window while in Creative mode
builderTools.settings.HideHeldItem.description = Hide the item in your hand while in Creative mode
builderTools.settings.ShowEntityMarkers.description = Show entity markers while in Creative mode
builderTools.settings.CreativeInteractionDistance.name = Block Place Distance
builderTools.settings.CreativeInteractionDistance.description = Controls the maximum distance you can place a block in Creative mode.
builderTools.settings.AirPlacement.name = Air Placing
builderTools.settings.AirPlacement.description = Allows you to place blocks in the air. Use the mouse scroll wheel to increase/decrease place distance.
builderTools.settings.FreePlace.name = Free Place
builderTools.settings.FreePlace.description = Allows you to freely place blocks in any direction. Best used while placing blocks rapidly.
builderTools.settings.NoPhysics.name = No Physics
builderTools.settings.NoPhysics.description = Allows you to disable block physics and lets you place any block anywhere.
builderTools.settings.HighlightBlockTarget.name = Highlight Block Target
builderTools.settings.HighlightBlockTarget.description = Highlight the block you are looking at.
builderTools.settings.QuickReplace.name = Replace
builderTools.settings.QuickReplace.description = Replaces the block you are looking at with the one you are holding.
builderTools.settings.QuickRetype.name = Retype
builderTools.settings.QuickRetype.description = Replaces the material of the block you are looking at with the one you are holding, but keeps the shape/variant of the block you are looking at.
builderTools.settings.Extrude.name = Extrude
builderTools.settings.Extrude.description = Extrudes the block placed by clicking and dragging in a direction you want.
builderTools.settings.SurfaceDraw.name = Draw
builderTools.settings.SurfaceDraw.description = Draw blocks where you are looking by clicking and dragging on a block face. The block face used and drag direction determines where drawing will happen.
builderTools.settings.FastPlace.name = Fast Place
builderTools.settings.FastPlace.description = Place blocks faster.
builderTools.settings.Eraser.name = Eraser
